{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(npm install)",
      "Bash(npm run:*)",
      "Bash(pip install:*)",
      "Bash(python api.py)",
      "Bash(python -m:*)",
      "Bash(python models/:*)",
      "Bash(python scripts/:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.git/config)"
    ]
  }
}

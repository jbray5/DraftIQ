# Copy to .env and fill in. Never commit the real .env.

# SportsData.io Baker key (projections / ADP / headshots)
SPORTSDATA_BAKER_KEY=

# Anthropic Claude API key — powers the AI draft coach
ANTHROPIC_API_KEY=
# Coach model (default claude-opus-4-8). Drop to claude-sonnet-4-6 or
# claude-haiku-4-5 for cheaper/faster live use.
ANTHROPIC_MODEL=claude-opus-4-8

# ESPN league access (for live ADP + historical drafts/standings/scores).
# Public leagues need only the league id. Private leagues also need the two
# cookies, copied from your browser while logged in to fantasy.espn.com.
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=

# Optional: keep around only if you still use the old OpenAI path.
OPENAI_API_KEY=
